# ============================================================================
# Auditor Fiscal de Cadastros — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# ============================================================================

# --- Ambiente ---------------------------------------------------------------
APP_ENV=desenvolvimento                 # desenvolvimento | teste | producao
FRONTEND_URL=http://localhost:5180
CORS_ORIGINS=["http://localhost:5180"]  # lista JSON de origens permitidas
LOG_LEVEL=INFO

# --- Portas no host (mude se já estiverem em uso na sua máquina) ---------------
API_HOST_PORT=8100
FRONTEND_HOST_PORT=5180
FLOWER_HOST_PORT=5556
DB_HOST_PORT=5432

# --- PostgreSQL ---------------------------------------------------------------
# Três papéis: dono do schema (migrações), aplicação (sujeita a RLS) e escrita da
# base de referência (superadministrador). Gere senhas fortes e distintas.
POSTGRES_USER=reforma_owner
POSTGRES_PASSWORD=troque-esta-senha-dono
POSTGRES_DB=reforma
APP_DB_PASSWORD=troque-esta-senha-app
REF_DB_PASSWORD=troque-esta-senha-ref
DATABASE_URL=postgresql+psycopg://reforma_app:troque-esta-senha-app@db:5432/reforma
REFERENCE_ADMIN_DATABASE_URL=postgresql+psycopg://reforma_ref:troque-esta-senha-ref@db:5432/reforma
MIGRATIONS_DATABASE_URL=postgresql+psycopg://reforma_owner:troque-esta-senha-dono@db:5432/reforma
DB_POOL_SIZE=10

# --- Redis / Celery ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# --- Segurança -----------------------------------------------------------------
JWT_SECRET=gere-com-python-c-import-secrets-print-secrets-token-urlsafe-64
JWT_ACCESS_MINUTES=15
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false                     # true em produção (HTTPS)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=600

# --- Arquivos ----------------------------------------------------------------------
UPLOAD_MAX_MB=50
UPLOAD_MAX_ROWS=100000
RETENTION_FILES_DAYS=30

# --- API do Claude (somente no servidor) ------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_PRIMARY=claude-sonnet-5
LLM_MODEL_ESCALATION=claude-opus-5-5
LLM_MODEL_LIGHT=claude-haiku-4-5-20251001
LLM_EFFORT_PRIMARY=medium
LLM_EFFORT_ESCALATION=high
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=5
LLM_BATCH_MIN_ITEMS=200                 # a partir deste nº de itens com IA, usa a Batch API
LLM_BATCH_POLL_SECONDS=30

# --- Embeddings locais ----------------------------------------------------------------
EMBEDDINGS_URL=http://embeddings:80
# Padrão: multilingual-e5-base (768 dim., ~1,5 GB de RAM). Em servidores com 6+ GB livres para o
# contêiner, prefira BAAI/bge-m3 (1024 dim., sem prefixos) — ver docs/adr/0003-embeddings.md.
# Trocar de modelo exige `make migrate` (ajusta a coluna) e reindexação (automática).
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base
EMBEDDINGS_DIM=768
EMBEDDINGS_QUERY_PREFIX="query: "
EMBEDDINGS_PASSAGE_PREFIX="passage: "
EMBEDDINGS_MEM_LIMIT=3g
EMBEDDINGS_BATCH=32

# --- Fontes oficiais (podem mudar; o upload manual é sempre aceito) --------------------
SOURCE_NCM_URL=https://portalunico.siscomex.gov.br/classif/api/publico/nomenclatura/download/json?perfil=PUBLICO
SOURCE_NBS_URL=https://www.gov.br/mdic/pt-br/images/REPOSITORIO/scs/decos/NBS/NBSa_2-0.csv
SOURCE_CCLASSTRIB_URL=https://dfe-portal.svrs.rs.gov.br/CFF/ClassificacaoTributaria
SOURCE_LC214_URL=https://www.planalto.gov.br/ccivil_03/leis/lcp/lcp214.htm

# --- Primeiro superadministrador (usado por `make bootstrap`) --------------------------
BOOTSTRAP_ADMIN_EMAIL=admin@plataforma.exemplo.com.br
BOOTSTRAP_ADMIN_NAME=Administrador da Plataforma

# --- Produção -----------------------------------------------------------------------
HTTP_PORT=8080
FLOWER_BASIC_AUTH=
